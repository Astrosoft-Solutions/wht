# The Apache virtual host points at the project root, so every request is routed into public/.
# This keeps .env, vendor/, storage/ and the rest of the source out of reach of the browser.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
